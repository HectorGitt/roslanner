generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Tenancy & auth =====

model Hospital {
  id         String          @id @default(cuid())
  name       String
  inviteCode String          @unique
  users      User[]
  wards      Ward[]
  roles      Role[]
  tiers      StaffTier[]
  holidays   PublicHoliday[]
  createdAt  DateTime        @default(now())
}

/// Public holidays, so they can be treated separately from ordinary days:
/// senior tiers can be kept off them, and working them is balanced over years.
model PublicHoliday {
  id         String   @id @default(cuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  date       DateTime
  name       String
  /// Groups recurring instances across years ("CHRISTMAS"), so "who worked it
  /// last year" can be answered without matching on date.
  groupKey   String

  @@unique([hospitalId, date])
}

// Better Auth managed models (user/session/account/verification)
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now())
  sessions      Session[]
  accounts      Account[]
  // App-specific tenancy fields
  hospitalId    String?
  hospital      Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  role          String    @default("MEMBER") // ADMIN | MEMBER

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now())

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @default(now())

  @@map("verification")
}

// ===== Rostering =====

model Ward {
  id               String                @id @default(cuid())
  name             String
  hospitalId       String
  hospital         Hospital              @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  /// Hospital's own label for the ward type ("Standard", "Call Duty",
  /// "Outpatient Clinic", …) — free text, deliberately not a fixed enum.
  category         String                @default("Standard")
  /// Days in one roster cycle: 7 for weekly wards, 30 for monthly stretches.
  cycleLengthDays  Int                   @default(7)
  requirements     CoverageRequirement[]
  staff            Staff[]
  rosters          Roster[]
  rules            RuleSet?
  shiftDefinitions ShiftDefinition[]
  /// Staff based elsewhere who may also be rostered here (float pool).
  floatStaff       StaffWardEligibility[]
  commitments      StaffDailyCommitment[]
  wardRules        WardRule[]
  createdAt        DateTime              @default(now())

  @@unique([hospitalId, name])
}

/// Lets a staff member be rostered in a ward that isn't their home ward.
/// Their home ward (Staff.wardId) is always eligible without a row here.
model StaffWardEligibility {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  wardId    String
  ward      Ward     @relation(fields: [wardId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([staffId, wardId])
}

/// One row per person per calendar date they are working, across every ward.
/// Wards are rostered independently, so this is what stops a floater being
/// booked in two wards on the same day: the unique index makes it impossible
/// to record two commitments for one person on one date, whatever code path
/// tries. Derived from Assignment and kept in step with it.
model StaffDailyCommitment {
  id           String     @id @default(cuid())
  staffId      String
  staff        Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  /// Absolute calendar date (midnight) — the point is cross-ward comparability.
  date         DateTime
  wardId       String
  ward         Ward       @relation(fields: [wardId], references: [id], onDelete: Cascade)
  rosterId     String
  roster       Roster     @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  assignmentId String     @unique
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  shiftCode    String

  @@unique([staffId, date])
}

// A configurable shift for a ward — replaces the assumption that every ward
// uses Morning/Afternoon/Night. Existing wards get these three backfilled
// automatically so nothing changes until an admin configures otherwise.
model ShiftDefinition {
  id              String   @id @default(cuid())
  wardId          String
  ward            Ward     @relation(fields: [wardId], references: [id], onDelete: Cascade)
  code            String   // stable short code, e.g. "MORNING", "CALL_DUTY"
  label           String   // hospital's own display name
  startMinutes    Int
  endMinutes      Int
  crossesMidnight Boolean  @default(false)
  isNightLike     Boolean  @default(false)
  payrollTag      String?
  sortOrder       Int      @default(0)

  @@unique([wardId, code])
}

// ===== Staff tiers (hospital-defined hierarchy) =====

model StaffTier {
  id                           String   @id @default(cuid())
  hospitalId                   String
  hospital                     Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  name                         String
  rank                         Int      @default(0)
  countsTowardClinicalCoverage Boolean  @default(true)
  maxConsecutiveNights         Int?
  staff                        Staff[]
  requirements                 CoverageRequirement[]
  wardRules                    WardRule[]
  shiftEligibility             TierShiftEligibility[]
  requiredPairingsAsDependent  TierPairingRule[] @relation("Dependent")
  requiredPairingsAsRequired   TierPairingRule[] @relation("Required")
  createdAt                    DateTime @default(now())

  @@unique([hospitalId, name])
}

// Per-tier, per-shift eligibility (e.g. Tier 1 = Morning only, never weekends/holidays).
// Keyed by shift *code*, not a ward's ShiftDefinition row: "interns can't work
// call duty" is a statement about the hospital's shift vocabulary, so one rule
// applies in every ward that has that shift. Keying it per-ward would force
// re-entering the same rule for each ward and silently enforce nothing in any
// ward an admin hadn't visited.
model TierShiftEligibility {
  id              String    @id @default(cuid())
  tierId          String
  tier            StaffTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  shiftCode       String
  eligible        Boolean   @default(true)
  weekendEligible Boolean   @default(true)
  holidayEligible Boolean   @default(true)

  @@unique([tierId, shiftCode])
}

// "Tier 3 must always have >=N of Tier 2 present" style pairing requirement.
model TierPairingRule {
  id               String    @id @default(cuid())
  dependentTierId  String
  dependentTier    StaffTier @relation("Dependent", fields: [dependentTierId], references: [id], onDelete: Cascade)
  requiredTierId   String
  requiredTier     StaffTier @relation("Required", fields: [requiredTierId], references: [id], onDelete: Cascade)
  minRequiredCount Int       @default(1)
  /// Shift code this applies to; null = every shift. NOTE: Postgres treats NULLs
  /// as distinct, so this unique index does NOT stop duplicate all-shift rules —
  /// the API checks for an existing rule before creating one.
  shiftCode        String?

  @@unique([dependentTierId, requiredTierId, shiftCode])
}

model Role {
  id           String                @id @default(cuid())
  name         String
  hospitalId   String
  hospital     Hospital              @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  staff        Staff[]
  requirements CoverageRequirement[]

  @@unique([hospitalId, name])
}

model Staff {
  id             String                 @id @default(cuid())
  name           String
  roleId         String
  role           Role                   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  /// Home ward. Additional wards they can float into live in StaffWardEligibility.
  wardId         String
  ward           Ward                   @relation(fields: [wardId], references: [id], onDelete: Cascade)
  tierId         String?
  tier           StaffTier?             @relation(fields: [tierId], references: [id], onDelete: SetNull)
  fte            Float                  @default(1.0)
  canBeLead      Boolean                @default(false)
  active         Boolean                @default(true)
  leaveRequests  LeaveRequest[]
  assignments    Assignment[]
  floatWards     StaffWardEligibility[]
  commitments    StaffDailyCommitment[]
  createdAt      DateTime               @default(now())
}

/// Required headcount for a ward + shift, scoped by role, tier, or both:
///   roleId set, tierId null → "2 Nurses"
///   roleId null, tierId set → "at least 1 Core Clinical" (the safety floor)
///   both set               → "1 Nurse who is also Core Clinical"
///   both null              → plain headcount for the shift
/// `shift` holds the ward's ShiftDefinition.code (not an FK — see Assignment).
/// NOTE: Postgres treats NULLs as distinct so these unique indexes don't fully
/// prevent duplicates; the coverage endpoint replaces a ward's rows wholesale.
model CoverageRequirement {
  id       String     @id @default(cuid())
  wardId   String
  ward     Ward       @relation(fields: [wardId], references: [id], onDelete: Cascade)
  shift    String
  roleId   String?
  role     Role?      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tierId   String?
  tier     StaffTier? @relation(fields: [tierId], references: [id], onDelete: Cascade)
  required Int
  /// Days of the week this applies to, 0 = Sunday … 6 = Saturday.
  /// Empty means every day — which is what every requirement used to mean, so
  /// existing rows keep their behaviour. Lets a clinic close at the weekend or a
  /// ward run lighter weekend cover.
  daysOfWeek Int[]    @default([])
  /// How public holidays are treated:
  ///   SAME    – follow the day of week the holiday falls on (default)
  ///   EXCLUDE – don't apply on holidays (clinic shut)
  ///   ONLY    – apply only on holidays (skeleton holiday cover)
  holidayRule String  @default("SAME")

  @@unique([wardId, shift, roleId, tierId, holidayRule])
}

// Per-ward scheduling rules.
model RuleSet {
  id                   String @id @default(cuid())
  wardId               String @unique
  ward                 Ward   @relation(fields: [wardId], references: [id], onDelete: Cascade)
  maxConsecutiveDays   Int    @default(6)
  maxNightsPerWeek     Int    @default(3)
  minDaysOffPerWeek    Int    @default(1)
  maxConsecutiveNights Int    @default(4)
  /// Minimum hours between the end of one shift and the start of the next,
  /// computed from each shift's actual times. Replaces the old
  /// noMorningAfterNight boolean, which couldn't express the 11–12h rest
  /// requirement or cope with wards whose shifts aren't 8/16/22. Null = unenforced.
  minRestHours         Int?   @default(8)
  /// Days of published history to fold into fairness, so nights/weekends/holidays
  /// are balanced over a rolling window rather than resetting each roster.
  /// 0 = judge each roster on its own (the original behaviour).
  fairnessWindowDays   Int    @default(0)
}

/// Rules whose shape doesn't fit a fixed column: they may be scoped to a tier or
/// a shift, and each type carries its own parameters.
///
/// `type` is a small vocabulary the engine knows how to interpret — the meaning
/// of a rule lives in code, only its thresholds and scope are data. A new kind of
/// rule is a new enum value plus a branch in evaluate(), not a schema change per
/// hospital.
model WardRule {
  id        String   @id @default(cuid())
  wardId    String
  ward      Ward     @relation(fields: [wardId], references: [id], onDelete: Cascade)
  type      RuleType
  /// Thresholds for this type, e.g. { "blockDays": 7 } or { "hours": 48 }.
  params    Json     @default("{}")
  /// Optional scope: null means every tier / every shift.
  tierId    String?
  tier      StaffTier? @relation(fields: [tierId], references: [id], onDelete: Cascade)
  shiftCode String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

enum RuleType {
  /// A run of night shifts must be followed by the same length of time off.
  /// params: { blockDays } — the length of a "week" of nights for this ward.
  BLOCK_PATTERN_ON_OFF
  /// Every shift needs exactly one designated lead, drawn from staff marked as
  /// able to lead. params: {}
  CHARGE_LEAD_REQUIRED
  /// Cap on hours worked in any rolling 7 days. params: { hours }
  MAX_HOURS_PER_WEEK
}

// type: "LEAVE" (hard — must be off) | "DAY_OFF_REQUEST" (soft preference)
model LeaveRequest {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  type      String   @default("LEAVE")
  note      String?
  createdAt DateTime @default(now())
}

model Roster {
  id          String                 @id @default(cuid())
  wardId      String
  ward        Ward                   @relation(fields: [wardId], references: [id], onDelete: Cascade)
  startDate   DateTime
  days        Int
  status      String                 @default("DRAFT") // DRAFT | PUBLISHED
  assignments Assignment[]
  commitments StaffDailyCommitment[]
  chargeLeads ChargeLeadAssignment[]
  swapRequests SwapRequest[]
  createdAt   DateTime               @default(now())
}

/// A proposed exchange of two assignments, and where it has got to.
///
/// Nothing here re-implements the rules: accepting and approving both run the
/// ordinary evaluate() over the grid the swap would produce, and compare it with
/// the grid as it stands. A swap that would introduce a hard violation is
/// rejected with the evaluation recorded, so the reason survives.
model SwapRequest {
  id       String     @id @default(cuid())
  rosterId String
  roster   Roster     @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  /// The shift being offered.
  requestingAssignmentId String
  requestingAssignment   Assignment @relation("SwapOffered", fields: [requestingAssignmentId], references: [id], onDelete: Cascade)
  /// The shift offered in exchange — set when the other party accepts.
  acceptingAssignmentId  String?
  acceptingAssignment    Assignment? @relation("SwapAccepted", fields: [acceptingAssignmentId], references: [id], onDelete: Cascade)
  status   SwapStatus @default(PENDING_ACCEPT)
  /// The evaluation of the proposed grid at the moment it was accepted, so a
  /// rejection can explain itself later.
  proposedEvaluation Json?
  note     String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
}

enum SwapStatus {
  /// Waiting for someone to offer a shift in exchange.
  PENDING_ACCEPT
  /// Accepted and rule-checked; waiting on the head of unit.
  PENDING_APPROVAL
  /// Would have broken a hard rule, so it never reached approval.
  HARD_RULE_REJECTED
  /// Turned down by the head of unit.
  DECLINED
  APPROVED
  CANCELLED
}

/// The one person in charge of a given shift. A side table rather than a flag on
/// Assignment because "exactly one per shift" is then a plain unique key, which
/// Prisma can express and the database can enforce.
model ChargeLeadAssignment {
  id           String     @id @default(cuid())
  assignmentId String     @unique
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  rosterId     String
  roster       Roster     @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  dayIndex     Int
  shiftCode    String

  @@unique([rosterId, dayIndex, shiftCode])
}

/// `shift` holds the ward's ShiftDefinition.code, or "DO" for a day off.
/// Deliberately not a foreign key: a published roster is a record of what was
/// worked, so it must survive a ward changing or removing a shift later.
model Assignment {
  id         String                @id @default(cuid())
  rosterId   String
  roster     Roster                @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  staffId    String
  staff      Staff                 @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dayIndex   Int
  shift      String
  commitment StaffDailyCommitment?
  chargeLead ChargeLeadAssignment?
  swapsOffered  SwapRequest[] @relation("SwapOffered")
  swapsAccepted SwapRequest[] @relation("SwapAccepted")

  @@unique([rosterId, staffId, dayIndex])
}
