generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Tenancy & auth =====

model Hospital {
  id         String      @id @default(cuid())
  name       String
  inviteCode String      @unique
  users      User[]
  wards      Ward[]
  roles      Role[]
  tiers      StaffTier[]
  createdAt  DateTime    @default(now())
}

// Better Auth managed models (user/session/account/verification)
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now())
  sessions      Session[]
  accounts      Account[]
  // App-specific tenancy fields
  hospitalId    String?
  hospital      Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  role          String    @default("MEMBER") // ADMIN | MEMBER

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now())

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @default(now())

  @@map("verification")
}

// ===== Rostering =====

model Ward {
  id              String                @id @default(cuid())
  name            String
  hospitalId      String
  hospital        Hospital              @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  requirements    CoverageRequirement[]
  staff           Staff[]
  rosters         Roster[]
  rules           RuleSet?
  shiftDefinitions ShiftDefinition[]
  createdAt       DateTime              @default(now())

  @@unique([hospitalId, name])
}

// A configurable shift for a ward — replaces the assumption that every ward
// uses Morning/Afternoon/Night. Existing wards get these three backfilled
// automatically so nothing changes until an admin configures otherwise.
model ShiftDefinition {
  id              String   @id @default(cuid())
  wardId          String
  ward            Ward     @relation(fields: [wardId], references: [id], onDelete: Cascade)
  code            String   // stable short code, e.g. "MORNING", "CALL_DUTY"
  label           String   // hospital's own display name
  startMinutes    Int
  endMinutes      Int
  crossesMidnight Boolean  @default(false)
  isNightLike     Boolean  @default(false)
  payrollTag      String?
  sortOrder       Int      @default(0)
  tierEligibility TierShiftEligibility[]
  pairingRules    TierPairingRule[]

  @@unique([wardId, code])
}

// ===== Staff tiers (hospital-defined hierarchy) =====

model StaffTier {
  id                           String   @id @default(cuid())
  hospitalId                   String
  hospital                     Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  name                         String
  rank                         Int      @default(0)
  countsTowardClinicalCoverage Boolean  @default(true)
  maxConsecutiveNights         Int?
  staff                        Staff[]
  shiftEligibility             TierShiftEligibility[]
  requiredPairingsAsDependent  TierPairingRule[] @relation("Dependent")
  requiredPairingsAsRequired   TierPairingRule[] @relation("Required")
  createdAt                    DateTime @default(now())

  @@unique([hospitalId, name])
}

// Per-tier, per-shift eligibility (e.g. Tier 1 = Morning only, never weekends/holidays).
model TierShiftEligibility {
  id              String          @id @default(cuid())
  tierId          String
  tier            StaffTier       @relation(fields: [tierId], references: [id], onDelete: Cascade)
  shiftDefId      String
  shiftDef        ShiftDefinition @relation(fields: [shiftDefId], references: [id], onDelete: Cascade)
  eligible        Boolean         @default(true)
  weekendEligible Boolean         @default(true)
  holidayEligible Boolean         @default(true)

  @@unique([tierId, shiftDefId])
}

// "Tier 3 must always have >=N of Tier 2 present" style pairing requirement.
model TierPairingRule {
  id               String           @id @default(cuid())
  dependentTierId  String
  dependentTier    StaffTier        @relation("Dependent", fields: [dependentTierId], references: [id], onDelete: Cascade)
  requiredTierId   String
  requiredTier     StaffTier        @relation("Required", fields: [requiredTierId], references: [id], onDelete: Cascade)
  minRequiredCount Int              @default(1)
  shiftDefId       String?          // null = applies to every shift
  shiftDef         ShiftDefinition? @relation(fields: [shiftDefId], references: [id], onDelete: Cascade)

  @@unique([dependentTierId, requiredTierId, shiftDefId])
}

model Role {
  id           String                @id @default(cuid())
  name         String
  hospitalId   String
  hospital     Hospital              @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  staff        Staff[]
  requirements CoverageRequirement[]

  @@unique([hospitalId, name])
}

model Staff {
  id            String         @id @default(cuid())
  name          String
  roleId        String
  role          Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  wardId        String
  ward          Ward           @relation(fields: [wardId], references: [id], onDelete: Cascade)
  tierId        String?
  tier          StaffTier?     @relation(fields: [tierId], references: [id], onDelete: SetNull)
  fte           Float          @default(1.0)
  canBeLead     Boolean        @default(false)
  active        Boolean        @default(true)
  leaveRequests LeaveRequest[]
  assignments   Assignment[]
  createdAt     DateTime       @default(now())
}

// Required headcount for a ward + shift + role.
// shift: "MORNING" | "AFTERNOON" | "NIGHT"
model CoverageRequirement {
  id       String @id @default(cuid())
  wardId   String
  ward     Ward   @relation(fields: [wardId], references: [id], onDelete: Cascade)
  shift    String
  roleId   String
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  required Int

  @@unique([wardId, shift, roleId])
}

// Per-ward scheduling rules.
model RuleSet {
  id                   String  @id @default(cuid())
  wardId               String  @unique
  ward                 Ward    @relation(fields: [wardId], references: [id], onDelete: Cascade)
  maxConsecutiveDays   Int     @default(6)
  maxNightsPerWeek     Int     @default(3)
  minDaysOffPerWeek    Int     @default(1)
  noMorningAfterNight  Boolean @default(true)
  maxConsecutiveNights Int     @default(4)
}

// type: "LEAVE" (hard — must be off) | "DAY_OFF_REQUEST" (soft preference)
model LeaveRequest {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  type      String   @default("LEAVE")
  note      String?
  createdAt DateTime @default(now())
}

model Roster {
  id          String       @id @default(cuid())
  wardId      String
  ward        Ward         @relation(fields: [wardId], references: [id], onDelete: Cascade)
  startDate   DateTime
  days        Int
  status      String       @default("DRAFT") // DRAFT | PUBLISHED
  assignments Assignment[]
  createdAt   DateTime     @default(now())
}

// shift: "MORNING" | "AFTERNOON" | "NIGHT" | "DO"
model Assignment {
  id       String @id @default(cuid())
  rosterId String
  roster   Roster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  staffId  String
  staff    Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dayIndex Int
  shift    String

  @@unique([rosterId, staffId, dayIndex])
}
